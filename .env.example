# OXION_API_KEY: Required for Oxion AI (OpenAI Compatible API).
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI (starts with cc_I...).
OXION_API_KEY="MY_OXION_API_KEY"

# OXION_BASE_URL: Base URL for Oxion AI API.
# Defaults to https://www.oxionai.com/v1 (compatible with https://api.oxion.ai/v1)
OXION_BASE_URL="https://www.oxionai.com/v1"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
